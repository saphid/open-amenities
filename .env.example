PORT=4173
HOST=127.0.0.1
DATABASE_PATH=./data/amenities.sqlite
# Required for production. No trailing slash or path. HTTPS terminates at your proxy.
PUBLIC_ORIGIN=https://amenities.example.org
# Replace with your actual operator URL/contact; required for production and place search.
# UPSTREAM_USER_AGENT=OpenAmenities/0.1 (https://your-real-domain.org; contact: you@your-real-domain.org)
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOCODER_URL=https://nominatim.openstreetmap.org/search
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
# Enable only with a staffed moderation queue and a public contact route.
REPORTS_ENABLED=false
# Set only behind exactly this many trusted reverse-proxy hops. Never use true.
TRUST_PROXY_HOPS=0
